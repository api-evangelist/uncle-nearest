        {
          "info": {
            "name": "Get organizers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://unclenearest.com/wp-json/tribe/events/v1/organizers",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "The collection page number."
              },
              {
                "name": "per_page",
                "value": "51",
                "type": "query",
                "description": "Maximum number of items to be returned in result set."
              },
              {
                "name": "search",
                "value": "Example",
                "type": "query",
                "description": "Limit results to those matching a string."
              },
              {
                "name": "event",
                "value": "126",
                "type": "query",
                "description": "Limit result set to organizers with specific event."
              },
              {
                "name": "has_events",
                "value": "true",
                "type": "query",
                "description": "Limit result set to organizers with events."
              },
              {
                "name": "only_with_upcoming",
                "value": "true",
                "type": "query",
                "description": "Limit result set to organizers with upcoming events."
              },
              {
                "name": "status",
                "value": "publish",
                "type": "query",
                "description": "Limit result set to organizers with specific status."
              }
            ]
          },
          "docs": "Returns a list of organizers"
